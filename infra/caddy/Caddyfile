# Groundwork ingress.
#
# One entrypoint. Everything behind it is private — this is the same shape as an
# Ingress in front of ClusterIP Services, which is why the Kubernetes track can
# quote this file directly.

{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	# Proxy's own liveness — answered here, never proxied.
	handle /healthz {
		respond "ok" 200
	}

	# Service-to-service endpoints are not for browsers. Denied here, before the
	# request reaches the API at all — the lab broker reaches them over the
	# internal network instead. scripts/assert-no-privileged.sh asserts this
	# rule still exists.
	handle /api/v1/internal/* {
		respond 404
	}

	# Lab broker: session lifecycle plus the terminal WebSocket. Only the broker
	# ever touches a container runtime.
	handle /labs/* {
		reverse_proxy lab-broker:8100
	}

	# API. The path prefix is stripped: /api/v1/health/live -> /v1/health/live
	handle_path /api/* {
		reverse_proxy api:8000 {
			health_uri /v1/health/live
			health_interval 10s
		}
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
