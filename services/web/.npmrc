# Next.js `output: standalone` traces the module graph and copies only what it
# finds. pnpm's default symlinked store defeats that trace for some transitive
# dependencies (@swc/helpers among them), producing an image that builds fine and
# then dies at startup with MODULE_NOT_FOUND.
#
# A hoisted (flat) node_modules is what the tracer expects. This costs some disk
# in the build stage and nothing at runtime, since the runtime stage ships no
# node_modules at all.
node-linker=hoisted

# Fail rather than silently resolving a different version than the lockfile says.
strict-peer-dependencies=false
engine-strict=true
