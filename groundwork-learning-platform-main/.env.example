# Copy to .env before the first `docker compose up`.
# Real secrets never belong in this file — it is committed.

# ---- general ----
GROUNDWORK_ENV=development
LOG_LEVEL=INFO
PUBLIC_PORT=8080

# ---- postgres ----
POSTGRES_USER=groundwork
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=groundwork
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- valkey ----
VALKEY_HOST=cache
VALKEY_PORT=6379

# ---- api ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-not-a-real-secret-run-task-bootstrap
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CONTENT_DIR=/content

# ---- web ----
# Server-side calls go over the internal network; browser calls go through the proxy.
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=/api

# ---- labs (opt-in: docker compose --profile labs up) ----
# Group that owns /var/run/docker.sock. 0 on Docker Desktop; on most Linux
# hosts it is the `docker` group — check with `stat -c %g /var/run/docker.sock`.
DOCKER_SOCKET_GID=0
# "docker" for real containers, "fake" to run the broker without a runtime.
LAB_PROVISIONER=docker

# ---- observability (opt-in: docker compose --profile observability up) ----
# Unset means the OTel SDK is present but exports nothing: no collector, no
# retry loops, no cost. Set it and every service starts reporting.
# Uncomment when running the profile, or use `task obs:up`, which sets it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
